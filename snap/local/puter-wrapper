#!/bin/sh
# Wrapper script for the Puter snap daemon.
# Reads snap configuration and launches the Node.js server.

set -eu

PORT=$(snapctl get port)
PORT="${PORT:-4100}"

export PUTER_CONFIG_PATH="$SNAP_COMMON/config.json"

# Always regenerate config so that `snap set puter port=...` takes effect
# on the next service restart.
cat > "$PUTER_CONFIG_PATH" <<EOF
{
    "domain": "puter.localhost",
    "protocol": "http",
    "pub_port": ${PORT},
    "env": "prod",
    "http_port": ${PORT}
}
EOF

cd "$SNAP"
exec "$SNAP/bin/node" \
    --enable-source-maps \
    -r ./dist/src/backend/telemetry.js \
    ./dist/src/backend/index.js
